SQL> CREATE OR REPLACE PACKAGE BODY sales_maintenance_pkg AS

  PROCEDURE refresh_sales_stats_proc AS
  2    3    4    BEGIN
  5      DBMS_STATS.GATHER_TABLE_STATS(
      ownname          => 'PDB2_INTERN',
      tabname          => 'SALES_DATA',
      estimate_percent => DBMS_STATS.AUTO_SAMPLE_SIZE
    );
  6    7    8    9   10  
    DELETE FROM SALES_SUMMARY;
    INSERT INTO SALES_SUMMARY (CATEGORY, TOTAL_SALES, LAST_REFRESH)
    SELECT CATEGORY, SUM(QUANTITY * PRICE), SYSDATE
    FROM SALES_DATA
    GROUP BY CATEGORY;

    COMMIT;
  END refresh_sales_stats_proc;

